<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="医学影像报告模板管理系统 —— AI 辅助生成诊断意见、保存报告并导出中文 PDF" />
  <title>医学影像报告模板管理系统</title>
  <style>
    :root {
      --bg: #f4f7fb;
      --card: #ffffff;
      --ink: #1c2b3a;
      --muted: #6b7c93;
      --primary: #1f5f8b;
      --primary-2: #2879a8;
      --accent: #2a9d8f;
      --danger: #a93226;
      --border: #dbe4ef;
      --ring: rgba(31, 95, 139, 0.15);
      --radius: 14px;
      --shadow: 0 10px 30px rgba(23, 58, 92, 0.08);
    }

    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      font-family: "Microsoft YaHei", "PingFang SC", "Noto Sans SC", system-ui, -apple-system, "Segoe UI", sans-serif;
      line-height: 1.6;
      background:
        radial-gradient(900px 520px at 8% -12%, #e3eef9 0%, rgba(227, 238, 249, 0) 62%),
        radial-gradient(760px 420px at 102% 0%, #e6f5f1 0%, rgba(230, 245, 241, 0) 58%),
        var(--bg);
    }

    button, input, select, textarea { font: inherit; }
    button { -webkit-tap-highlight-color: transparent; }

    /* ---------- 顶栏 ---------- */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 13px clamp(16px, 4vw, 40px);
      background: rgba(255, 255, 255, 0.9);
      border-bottom: 1px solid rgba(219, 228, 239, 0.9);
      backdrop-filter: blur(12px);
    }

    .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }

    .brand-mark {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      flex: none;
      border-radius: 12px;
      color: #fff;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 1px;
      background: linear-gradient(135deg, #1f5f8b, #2a9d8f);
      box-shadow: 0 6px 16px rgba(31, 95, 139, 0.25);
    }

    .brand h1 { margin: 0; font-size: 17px; letter-spacing: 0.02em; white-space: nowrap; }
    .brand p {
      margin: 1px 0 0;
      color: var(--muted);
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .top-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
    .user-area { display: flex; align-items: center; gap: 8px; }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 10px;
      border: 1px solid transparent;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      white-space: nowrap;
    }
    .badge::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }
    .badge.idle { color: #6b7c93; background: #eef2f7; border-color: #dde5ef; }
    .badge.ok { color: #1b7a6b; background: #e7f6f2; border-color: #c4e9e1; }
    .badge.warn { color: #9a6500; background: #fff5df; border-color: #f1d9a7; }
    .badge.danger { color: #a93226; background: #fdecea; border-color: #f5c6c0; }

    .user-chip {
      padding: 5px 10px;
      border: 1px solid #d9e6f2;
      border-radius: 999px;
      background: #eef4fa;
      color: #35506b;
      font-size: 12.5px;
      white-space: nowrap;
    }

    /* ---------- 布局 ---------- */
    .page {
      width: min(1040px, 100%);
      margin: 0 auto;
      padding: clamp(18px, 3vw, 32px) clamp(14px, 3vw, 24px) 44px;
      display: grid;
      gap: 18px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    /* ---------- 登录卡片 ---------- */
    .auth-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 22px;
      padding: 18px 22px;
      border-left: 4px solid var(--accent);
    }

    .auth-intro { min-width: 250px; }
    .auth-intro h2 { margin: 3px 0 4px; font-size: 16px; }
    .auth-intro p { margin: 0; color: var(--muted); font-size: 12.5px; }

    .kicker {
      display: block;
      color: var(--accent);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.18em;
    }

    .auth-form { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
    .auth-form input { width: 158px; }

    .linklike {
      padding: 0;
      border: 0;
      background: none;
      color: var(--primary);
      font: inherit;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }
    .linklike:hover { color: var(--primary-2); }

    /* ---------- 表单控件 ---------- */
    input, select, textarea {
      width: 100%;
      padding: 10px 12px;
      color: var(--ink);
      background: #fbfdff;
      border: 1px solid var(--border);
      border-radius: 9px;
      transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    }

    input:hover, select:hover, textarea:hover { border-color: #c4d5e5; }

    input:focus, select:focus, textarea:focus {
      outline: none;
      background: #fff;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--ring);
    }

    textarea { min-height: 124px; line-height: 1.75; resize: vertical; }
    textarea::placeholder, input::placeholder { color: #a7b4c4; }

    /* ---------- 按钮 ---------- */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 16px;
      border: 1px solid transparent;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      white-space: nowrap;
      cursor: pointer;
      transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease, color 0.15s ease, opacity 0.15s ease;
    }

    .btn:hover:not(:disabled) { transform: translateY(-1px); }
    .btn:active:not(:disabled) { transform: translateY(0); }
    .btn:disabled { opacity: 0.62; cursor: not-allowed; }

    .btn.primary {
      color: #fff;
      background: linear-gradient(135deg, #1f5f8b, #2879a8);
      box-shadow: 0 8px 18px rgba(31, 95, 139, 0.22);
    }
    .btn.primary:hover:not(:disabled) { box-shadow: 0 10px 22px rgba(31, 95, 139, 0.3); }

    .btn.secondary { color: #174a6d; background: #e8f1f8; border-color: #cfe0ee; }
    .btn.secondary:hover:not(:disabled) { background: #dcebf6; }

    .btn.ghost { color: var(--muted); background: #fff; border-color: var(--border); }
    .btn.ghost:hover:not(:disabled) { color: var(--primary); border-color: #b9cfe2; }

    .btn.small { padding: 7px 12px; border-radius: 8px; font-size: 13px; }

    .btn.is-busy::after {
      content: "";
      width: 13px;
      height: 13px;
      flex: none;
      border: 2px solid currentColor;
      border-top-color: transparent;
      border-radius: 50%;
      animation: spin 0.75s linear infinite;
    }

    .btn.is-busy .spark { display: none; }

    /* ---------- 报告卡片 ---------- */
    .report-card { padding: clamp(18px, 3vw, 30px); }

    .card-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 6px;
    }
    .card-head h2 { margin: 3px 0 0; font-size: 22px; letter-spacing: 0.01em; }

    .head-tag {
      padding: 4px 10px;
      border: 1px solid #c4e9e1;
      border-radius: 999px;
      color: #2a7f72;
      background: #e7f6f2;
      font-size: 12px;
      white-space: nowrap;
    }

    .banner {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin: 12px 0 2px;
      padding: 10px 14px;
      border: 1px solid #f1d9a7;
      border-radius: 10px;
      color: #7c5600;
      background: #fff8e8;
      font-size: 12.5px;
    }
    .banner strong { flex: none; color: #9a6500; }
    .banner span { line-height: 1.55; }

    .section { padding: 22px 0; border-top: 1px dashed #e4ebf3; }
    .section:first-of-type { padding-top: 14px; border-top: 0; }

    .section-title {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
      font-size: 15px;
      font-weight: 700;
    }

    .step {
      display: inline-grid;
      place-items: center;
      width: 26px;
      height: 26px;
      flex: none;
      border-radius: 8px;
      color: var(--primary);
      background: #e8f1f8;
      font-size: 11px;
      font-weight: 700;
    }

    .grid { display: grid; gap: 14px; }
    .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }

    .field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .field > span { color: #41556b; font-size: 12.5px; font-weight: 600; }

    .inline { display: flex; gap: 8px; }
    .inline select { flex: 1; min-width: 0; }

    .field-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 6px;
      color: var(--muted);
      font-size: 12px;
    }
    .count { flex: none; font-variant-numeric: tabular-nums; }

    .generate { width: 100%; margin-top: 14px; padding: 12px 18px; }
    .spark { width: 18px; height: 18px; flex: none; }

    /* ---------- 底部操作区 ---------- */
    .actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      padding-top: 22px;
      border-top: 1px solid var(--border);
    }

    .report-status { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 13px; }

    .status-dot {
      width: 8px;
      height: 8px;
      flex: none;
      border-radius: 50%;
      background: #c3cfdd;
      box-shadow: 0 0 0 4px rgba(195, 207, 221, 0.18);
      transition: background 0.2s ease, box-shadow 0.2s ease;
    }
    .status-dot.ok { background: var(--accent); box-shadow: 0 0 0 4px rgba(42, 157, 143, 0.16); }

    .action-buttons { display: flex; gap: 10px; flex-wrap: wrap; }

    /* ---------- 使用提示 ---------- */
    .tips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }

    .tip {
      padding: 14px 16px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.66);
      color: var(--muted);
      font-size: 12.5px;
    }
    .tip strong { display: block; margin-bottom: 3px; color: var(--ink); font-size: 13px; }

    .page-foot { padding-top: 2px; color: #93a3b5; font-size: 11.5px; text-align: center; }

    /* ---------- Toast ---------- */
    .toast-host {
      position: fixed;
      right: 18px;
      bottom: 18px;
      z-index: 50;
      display: flex;
      flex-direction: column;
      gap: 10px;
      width: min(380px, calc(100vw - 36px));
      pointer-events: none;
    }

    .toast {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 12px 14px;
      border-radius: 10px;
      color: #fff;
      background: #2a4560;
      box-shadow: 0 12px 30px rgba(16, 38, 60, 0.25);
      font-size: 13px;
      line-height: 1.5;
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .toast.show { opacity: 1; transform: translateY(0); }
    .toast.success { background: #1d6f62; }
    .toast.error { background: #a93226; }
    .toast.info { background: #2a4560; }

    .toast-icon {
      display: grid;
      place-items: center;
      width: 18px;
      height: 18px;
      flex: none;
      margin-top: 1px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.18);
      font-size: 11px;
      font-weight: 700;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    /* ---------- 响应式 ---------- */
    @media (max-width: 860px) {
      .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .tips { grid-template-columns: 1fr; }
      .auth-card { flex-direction: column; align-items: stretch; gap: 14px; }
      .auth-form input { flex: 1; width: auto; min-width: 140px; }
    }

    @media (max-width: 620px) {
      .topbar { flex-direction: column; align-items: flex-start; }
      .top-actions { width: 100%; justify-content: space-between; }
      .grid-2, .grid-4 { grid-template-columns: 1fr; }
      .card-head { flex-direction: column; }
      .brand h1 { font-size: 15px; white-space: normal; }
      .brand p { display: none; }
      .brand-mark { width: 36px; height: 36px; border-radius: 10px; }
      .action-buttons { width: 100%; }
      .action-buttons .btn { flex: 1; }
      .actions { align-items: flex-start; }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.001ms !important;
        transition-duration: 0.001ms !important;
      }
      html { scroll-behavior: auto; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark" aria-hidden="true">影</div>
      <div>
        <h1>医学影像报告模板管理系统</h1>
        <p>Medical Imaging Report System</p>
      </div>
    </div>
    <div class="top-actions">
      <span class="badge idle" id="llmBadge">检测服务中…</span>
      <div class="user-area" id="userArea"></div>
    </div>
  </header>

  <main class="page">
    <section class="card auth-card" id="authCard" hidden>
      <div class="auth-intro">
        <span class="kicker">DOCTOR ACCESS</span>
        <h2>登录后保存报告与导出 PDF</h2>
        <p>演示账号：<button type="button" class="linklike" id="fillDemoBtn">admin / 123456</button>，点击自动填入。</p>
      </div>
      <form class="auth-form" id="authForm">
        <input id="authUsername" name="username" type="text" placeholder="用户名" maxlength="32" autocomplete="username" aria-label="用户名" />
        <input id="authPassword" name="password" type="password" placeholder="密码" maxlength="64" autocomplete="current-password" aria-label="密码" />
        <button class="btn primary" type="submit" id="loginBtn">登录</button>
        <button class="btn ghost" type="button" id="registerBtn">注册</button>
      </form>
    </section>

    <section class="card report-card">
      <div class="card-head">
        <div>
          <span class="kicker">REPORT WORKSPACE</span>
          <h2>影像报告生成</h2>
        </div>
        <span class="head-tag">AI 辅助 · 医生复核</span>
      </div>

      <div class="banner" id="llmNotice" hidden>
        <strong>提示</strong>
        <span id="llmNoticeText"></span>
      </div>

      <form id="reportForm" novalidate>
        <div class="section">
          <div class="section-title"><span class="step">01</span>检查信息</div>
          <div class="grid grid-2">
            <label class="field" for="category">
              <span>检查分类</span>
              <select id="category">
                <option value="">加载中…</option>
              </select>
            </label>
            <div class="field">
              <span>报告模板（可选）</span>
              <div class="inline">
                <select id="templateSelect" aria-label="报告模板">
                  <option value="">不使用模板</option>
                </select>
                <button class="btn ghost" type="button" id="applyTemplateBtn">载入</button>
              </div>
            </div>
          </div>
        </div>

        <div class="section">
          <div class="section-title"><span class="step">02</span>影像所见</div>
          <textarea id="findings" maxlength="20000" rows="7"
            placeholder="例如：双侧大脑半球对称，脑实质未见明显异常密度影，脑室系统无扩大，中线结构居中。"></textarea>
          <div class="field-foot">
            <span>支持多行文本，AI 将据此生成诊断意见。</span>
            <span class="count" id="findingsCount">0 / 20000</span>
          </div>
          <button class="btn primary generate" type="button" id="generateBtn">
            <svg class="spark" viewBox="0 0 24 24" aria-hidden="true" fill="none">
              <path d="M12 2l1.8 5.2L19 9l-5.2 1.8L12 16l-1.8-5.2L5 9l5.2-1.8L12 2z" fill="currentColor"/>
              <path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9L19 15z" fill="currentColor" opacity=".7"/>
            </svg>
            <span class="label">AI 生成诊断意见</span>
          </button>
        </div>

        <div class="section">
          <div class="section-title"><span class="step">03</span>诊断意见</div>
          <textarea id="conclusion" maxlength="20000" rows="7"
            placeholder="AI 生成后显示在这里，可手动修改。"></textarea>
          <div class="field-foot">
            <span>AI 生成结果仅供参考，请医生核对后使用。</span>
            <span class="count" id="conclusionCount">0 / 20000</span>
          </div>
        </div>

        <div class="section">
          <div class="section-title"><span class="step">04</span>患者信息</div>
          <div class="grid grid-4">
            <label class="field" for="patientName">
              <span>患者姓名</span>
              <input id="patientName" type="text" maxlength="50" placeholder="如：张三" autocomplete="off" />
            </label>
            <label class="field" for="patientGender">
              <span>性别</span>
              <select id="patientGender">
                <option value="未知" selected>未知</option>
                <option value="男">男</option>
                <option value="女">女</option>
                <option value="其他">其他</option>
              </select>
            </label>
            <label class="field" for="patientAge">
              <span>年龄</span>
              <input id="patientAge" type="number" min="0" max="150" step="1" placeholder="如：58" />
            </label>
            <label class="field" for="patientRecordNo">
              <span>病历号</span>
              <input id="patientRecordNo" type="text" maxlength="50" placeholder="如：CT202610220018" autocomplete="off" />
            </label>
          </div>
        </div>

        <div class="actions">
          <div class="report-status">
            <span class="status-dot" id="statusDot"></span>
            <span id="reportStatus">尚未保存报告</span>
          </div>
          <div class="action-buttons">
            <button class="btn ghost" type="button" id="resetBtn">清空</button>
            <button class="btn secondary" type="button" id="saveBtn">保存报告</button>
            <button class="btn primary" type="button" id="pdfBtn">生成 PDF</button>
          </div>
        </div>
      </form>
    </section>

    <section class="tips">
      <div class="tip"><strong>AI 辅助，需医生复核</strong>生成内容基于影像所见，不能替代最终诊断。</div>
      <div class="tip"><strong>患者隐私保护</strong>姓名、病历号只保存在本地数据库，不会发送给大模型。</div>
      <div class="tip"><strong>中文 PDF</strong>采用宋体排版，包含患者信息、影像所见与诊断意见。</div>
    </section>

    <footer class="page-foot">医学影像报告模板管理系统 · FastAPI + SQLite + DeepSeek + ReportLab</footer>
  </main>

  <div class="toast-host" id="toastHost" aria-live="polite" aria-atomic="false"></div>

  <script>
    (() => {
      "use strict";

      const MAX_TEXT = 20000;
      const STORAGE_KEY = "medicalReportSystem.user";
      const $ = (id) => document.getElementById(id);

      const els = {
        llmBadge: $("llmBadge"),
        userArea: $("userArea"),
        authCard: $("authCard"),
        authForm: $("authForm"),
        authUsername: $("authUsername"),
        authPassword: $("authPassword"),
        loginBtn: $("loginBtn"),
        registerBtn: $("registerBtn"),
        fillDemoBtn: $("fillDemoBtn"),
        llmNotice: $("llmNotice"),
        llmNoticeText: $("llmNoticeText"),
        reportForm: $("reportForm"),
        category: $("category"),
        templateSelect: $("templateSelect"),
        applyTemplateBtn: $("applyTemplateBtn"),
        findings: $("findings"),
        conclusion: $("conclusion"),
        findingsCount: $("findingsCount"),
        conclusionCount: $("conclusionCount"),
        generateBtn: $("generateBtn"),
        patientName: $("patientName"),
        patientGender: $("patientGender"),
        patientAge: $("patientAge"),
        patientRecordNo: $("patientRecordNo"),
        saveBtn: $("saveBtn"),
        pdfBtn: $("pdfBtn"),
        resetBtn: $("resetBtn"),
        reportStatus: $("reportStatus"),
        statusDot: $("statusDot"),
        toastHost: $("toastHost"),
      };

      const state = {
        user: null,
        categories: [],
        templates: [],
        templateId: null,
        currentReportId: null,
        dirty: false,
        llmConfigured: null,
      };

      /* ---------------- 基础工具 ---------------- */
      function formatReportNo(id) {
        return "R" + String(id).padStart(6, "0");
      }

      function toast(message, type = "info", duration = 3800) {
        const box = document.createElement("div");
        box.className = "toast " + type;

        const icon = document.createElement("span");
        icon.className = "toast-icon";
        icon.textContent = type === "success" ? "✓" : type === "error" ? "!" : "i";

        const text = document.createElement("span");
        text.textContent = message;

        box.append(icon, text);
        els.toastHost.appendChild(box);
        requestAnimationFrame(() => box.classList.add("show"));

        window.setTimeout(() => {
          box.classList.remove("show");
          window.setTimeout(() => box.remove(), 240);
        }, duration);
      }

      async function api(path, options = {}) {
        let response;
        try {
          const headers = { ...(options.headers || {}) };
          if (options.body) headers["Content-Type"] = "application/json";
          response = await fetch(path, { ...options, headers });
        } catch (error) {
          throw new Error("无法连接后端服务，请确认已通过 http://127.0.0.1:8000/ 打开本页，且 uvicorn 正在运行。");
        }

        const raw = await response.text();
        let data = null;
        if (raw) {
          try {
            data = JSON.parse(raw);
          } catch (error) {
            data = raw;
          }
        }

        if (!response.ok) {
          throw new Error(extractError(data, response.status));
        }
        return data;
      }

      function extractError(data, status) {
        if (!data) return "请求失败（HTTP " + status + "）";
        if (typeof data === "string") return data;
        if (typeof data.detail === "string") return data.detail;
        if (Array.isArray(data.detail)) {
          return data.detail.map((item) => (item && item.msg) || JSON.stringify(item)).join("；");
        }
        return "请求失败（HTTP " + status + "）";
      }

      function setBusy(button, busy, busyText) {
        const label = button.querySelector(".label") || button;
        if (busy) {
          button.dataset.previousText = label.textContent;
          button.disabled = true;
          button.classList.add("is-busy");
          if (busyText) label.textContent = busyText;
        } else {
          button.disabled = false;
          button.classList.remove("is-busy");
          if (button.dataset.previousText) {
            label.textContent = button.dataset.previousText;
            delete button.dataset.previousText;
          }
        }
      }

      function showAuth(message) {
        els.authCard.hidden = false;
        if (message) toast(message, "error", 5000);
        els.authCard.scrollIntoView({ behavior: "smooth", block: "center" });
        window.setTimeout(() => els.authUsername.focus({ preventScroll: true }), 320);
      }

      /* ---------------- 登录状态 ---------------- */
      function readStoredUser() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return null;
          const parsed = JSON.parse(raw);
          if (parsed && Number.isInteger(parsed.id) && typeof parsed.username === "string") {
            return parsed;
          }
        } catch (error) {
          console.warn("读取本地登录状态失败", error);
        }
        return null;
      }

      function persistUser(user) {
        state.user = user;
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(user));
        } catch (error) {
          console.warn("保存本地登录状态失败", error);
        }
        renderUser();
      }

      function clearUser() {
        state.user = null;
        try {
          localStorage.removeItem(STORAGE_KEY);
        } catch (error) {
          console.warn("清除本地登录状态失败", error);
        }
        renderUser();
      }

      function renderUser() {
        els.userArea.replaceChildren();

        if (state.user) {
          els.authCard.hidden = true;

          const chip = document.createElement("span");
          chip.className = "user-chip";
          chip.textContent = "医生 · " + state.user.username;

          const logout = document.createElement("button");
          logout.type = "button";
          logout.className = "btn ghost small";
          logout.textContent = "退出";
          logout.addEventListener("click", () => {
            clearUser();
            toast("已退出登录", "info");
          });

          els.userArea.append(chip, logout);
          return;
        }

        els.authCard.hidden = false;
        const open = document.createElement("button");
        open.type = "button";
        open.className = "btn ghost small";
        open.textContent = "登录 / 注册";
        open.addEventListener("click", () => {
          els.authCard.scrollIntoView({ behavior: "smooth", block: "center" });
          els.authUsername.focus({ preventScroll: true });
        });
        els.userArea.append(open);
      }

      /* ---------------- 登录 / 注册 ---------------- */
      els.authForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        await login();
      });

      async function login() {
        const username = els.authUsername.value.trim();
        const password = els.authPassword.value;
        if (!username || !password) {
          toast("请输入用户名和密码", "error");
          return;
        }

        setBusy(els.loginBtn, true, "登录中…");
        try {
          const data = await api("/login", {
            method: "POST",
            body: JSON.stringify({ username, password }),
          });
          els.authForm.reset();
          persistUser(data.user);
          toast("欢迎回来，" + data.user.username, "success");
        } catch (error) {
          toast(error.message, "error", 6000);
        } finally {
          setBusy(els.loginBtn, false);
        }
      }

      els.registerBtn.addEventListener("click", async () => {
        const username = els.authUsername.value.trim();
        const password = els.authPassword.value;

        if (username.length < 3) {
          toast("用户名至少 3 个字符", "error");
          els.authUsername.focus();
          return;
        }
        if (password.length < 6) {
          toast("密码至少 6 个字符", "error");
          els.authPassword.focus();
          return;
        }

        setBusy(els.registerBtn, true, "注册中…");
        try {
          await api("/register", {
            method: "POST",
            body: JSON.stringify({ username, password }),
          });
          const data = await api("/login", {
            method: "POST",
            body: JSON.stringify({ username, password }),
          });
          els.authForm.reset();
          persistUser(data.user);
          toast("注册成功，已自动登录", "success");
        } catch (error) {
          toast(error.message, "error", 6000);
        } finally {
          setBusy(els.registerBtn, false);
        }
      });

      els.fillDemoBtn.addEventListener("click", () => {
        els.authUsername.value = "admin";
        els.authPassword.value = "123456";
        els.authPassword.focus();
      });

      /* ---------------- 服务状态 ---------------- */
      function renderHealth() {
        if (state.llmConfigured === true) {
          els.llmBadge.className = "badge ok";
          els.llmBadge.textContent = "AI 已就绪";
          els.llmNotice.hidden = true;
          return;
        }

        if (state.llmConfigured === false) {
          els.llmBadge.className = "badge warn";
          els.llmBadge.textContent = "AI 未配置";
          els.llmNotice.hidden = false;
          els.llmNoticeText.textContent = "服务端未配置 DEEPSEEK_API_KEY，AI 生成将返回 503。设置环境变量并重启服务后刷新本页。";
          return;
        }

        els.llmBadge.className = "badge danger";
        els.llmBadge.textContent = "服务未连接";
        els.llmNotice.hidden = false;
        els.llmNoticeText.textContent = "无法连接后端服务，请确认已通过 http://127.0.0.1:8000/ 打开本页，且 uvicorn 正在运行。";
      }

      async function loadHealth() {
        try {
          const data = await api("/health");
          state.llmConfigured = Boolean(data.llm_configured);
        } catch (error) {
          state.llmConfigured = null;
          console.warn(error);
        }
        renderHealth();
      }

      /* ---------------- 分类 / 模板 ---------------- */
      async function loadCategories() {
        try {
          const items = await api("/prompt_configs");
          state.categories = Array.isArray(items) ? items : [];

          const options = [new Option("请选择检查分类", "")];
          state.categories.forEach((item) => options.push(new Option(item.category, item.category)));
          els.category.replaceChildren(...options);

          if (state.categories.length > 0) {
            els.category.value = state.categories[0].category;
          }
        } catch (error) {
          els.category.replaceChildren(new Option("分类加载失败", ""));
          toast("检查分类加载失败：" + error.message, "error", 6000);
        }
      }

      async function loadTemplates() {
        try {
          const items = await api("/templates?limit=200");
          state.templates = Array.isArray(items) ? items : [];

          const options = [new Option("不使用模板", "")];
          state.templates.forEach((item) => {
            options.push(new Option(item.title + "（" + item.category + "）", String(item.id)));
          });
          els.templateSelect.replaceChildren(...options);
        } catch (error) {
          console.warn("模板加载失败", error);
          els.templateSelect.replaceChildren(new Option("模板加载失败", ""));
        }
      }

      els.applyTemplateBtn.addEventListener("click", () => {
        const id = Number(els.templateSelect.value);
        if (!id) {
          toast("请先选择一个模板", "info");
          return;
        }

        const template = state.templates.find((item) => item.id === id);
        if (!template) {
          toast("模板数据已失效，请刷新页面", "error");
          return;
        }

        if (
          (els.findings.value.trim() || els.conclusion.value.trim()) &&
          !window.confirm("载入模板会覆盖当前影像所见和诊断意见，是否继续？")
        ) {
          return;
        }

        els.findings.value = template.findings || "";
        els.conclusion.value = template.conclusion || "";
        if (Array.from(els.category.options).some((option) => option.value === template.category)) {
          els.category.value = template.category;
        }

        state.templateId = template.id;
        markDirty();
        updateCounts();
        toast("模板已载入", "success");
      });

      /* ---------------- 计数 / 状态 ---------------- */
      function updateCounts() {
        els.findingsCount.textContent = els.findings.value.length + " / " + MAX_TEXT;
        els.conclusionCount.textContent = els.conclusion.value.length + " / " + MAX_TEXT;
      }

      function updateReportStatus() {
        if (state.currentReportId !== null) {
          els.reportStatus.textContent = "已保存：" + formatReportNo(state.currentReportId);
          els.statusDot.classList.add("ok");
          return;
        }

        els.reportStatus.textContent = state.dirty ? "内容有修改，尚未保存" : "尚未保存报告";
        els.statusDot.classList.remove("ok");
      }

      function markDirty() {
        state.dirty = true;
        state.currentReportId = null;
        updateReportStatus();
      }

      els.templateSelect.addEventListener("change", () => {
        const selected = Number(els.templateSelect.value) || null;
        if (selected !== state.templateId) {
          state.templateId = null;
        }
      });

      els.reportForm.addEventListener("input", (event) => {
        if (event.target === els.findings || event.target === els.conclusion) {
          updateCounts();
        }
        if (event.target.matches("input, textarea, select")) {
          markDirty();
        }
      });

      els.reportForm.addEventListener("change", (event) => {
        if (event.target.matches("select")) {
          markDirty();
        }
      });

      els.reportForm.addEventListener("submit", (event) => event.preventDefault());

      /* ---------------- AI 生成 ---------------- */
      els.generateBtn.addEventListener("click", async () => {
        const category = els.category.value;
        const findings = els.findings.value.trim();

        if (!category) {
          toast("请先选择检查分类", "error");
          els.category.focus();
          return;
        }
        if (!findings) {
          toast("请先填写影像所见", "error");
          els.findings.focus();
          return;
        }

        setBusy(els.generateBtn, true, "AI 生成中…");
        try {
          const data = await api("/generate_conclusion", {
            method: "POST",
            body: JSON.stringify({ category, findings }),
          });

          els.conclusion.value = data.conclusion || "";
          updateCounts();
          markDirty();
          toast("诊断意见已生成，请核对后保存", "success");
          els.conclusion.focus();
        } catch (error) {
          toast(error.message, "error", 7000);
        } finally {
          setBusy(els.generateBtn, false);
        }
      });

      /* ---------------- 保存报告 ---------------- */
      function collectReport() {
        const ageText = els.patientAge.value.trim();
        return {
          template_id: state.templateId,
          patient_name: els.patientName.value.trim(),
          patient_gender: els.patientGender.value || "未知",
          patient_age: ageText === "" ? null : Number(ageText),
          patient_record_no: els.patientRecordNo.value.trim(),
          findings: els.findings.value.trim(),
          conclusion: els.conclusion.value.trim(),
          doctor_id: state.user ? state.user.id : null,
        };
      }

      function validateReport(payload) {
        if (!payload.patient_name) return "请填写患者姓名";
        if (!payload.findings) return "请填写影像所见";
        if (!payload.conclusion) return "请填写诊断意见";
        if (payload.patient_age !== null) {
          if (
            !Number.isInteger(payload.patient_age) ||
            payload.patient_age < 0 ||
            payload.patient_age > 150
          ) {
            return "年龄需为 0~150 之间的整数";
          }
        }
        return "";
      }

      async function saveReport({ button = els.saveBtn, silent = false } = {}) {
        if (!state.user) {
          showAuth("请先登录后再保存报告");
          return null;
        }

        const payload = collectReport();
        const error = validateReport(payload);
        if (error) {
          toast(error, "error");
          return null;
        }

        setBusy(button, true, "保存中…");
        try {
          const report = await api("/reports", {
            method: "POST",
            body: JSON.stringify(payload),
          });

          state.currentReportId = report.id;
          state.dirty = false;
          updateReportStatus();

          if (!silent) {
            toast("报告已保存（" + formatReportNo(report.id) + "）", "success");
          }
          return report;
        } catch (error) {
          toast(error.message, "error", 7000);
          return null;
        } finally {
          setBusy(button, false);
        }
      }

      els.saveBtn.addEventListener("click", () => saveReport());

      /* ---------------- 导出 PDF ---------------- */
      async function exportPdf() {
        if (!state.user) {
          showAuth("请先登录后再导出 PDF");
          return;
        }

        if (state.currentReportId !== null) {
          window.open("/reports/" + state.currentReportId + "/pdf", "_blank");
          return;
        }

        const preview = window.open("about:blank", "_blank");
        const report = await saveReport({ button: els.pdfBtn, silent: true });

        if (!report) {
          if (preview) preview.close();
          return;
        }

        const url = "/reports/" + report.id + "/pdf";
        if (preview) {
          preview.location.href = url;
        } else {
          window.open(url, "_blank");
        }
        toast("PDF 已生成，正在新窗口打开", "success");
      }

      els.pdfBtn.addEventListener("click", exportPdf);

      /* ---------------- 清空 ---------------- */
      els.resetBtn.addEventListener("click", () => {
        if (!window.confirm("确定清空当前表单内容？")) return;

        els.reportForm.reset();
        els.patientGender.value = "未知";
        els.templateSelect.value = "";
        state.templateId = null;
        state.currentReportId = null;
        state.dirty = false;

        if (state.categories.length > 0) {
          els.category.value = state.categories[0].category;
        }

        updateCounts();
        updateReportStatus();
        toast("表单已清空", "info");
      });

      /* ---------------- 初始化 ---------------- */
      async function bootstrap() {
        state.user = readStoredUser();
        renderUser();
        updateCounts();
        updateReportStatus();

        await Promise.allSettled([loadHealth(), loadCategories(), loadTemplates()]);
      }

      bootstrap();
    })();
  </script>
</body>
</html>
